[Unit]
Description=Log Analyzer Backend (dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Dokumente/LotusIT/Projekte/logAnalyzer/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source .venv/bin/activate && exec uvicorn app.main:app --host 127.0.0.1 --port 8000'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
