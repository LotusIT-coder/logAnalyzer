[Unit]
Description=Log Analyzer Frontend (dev)
After=network-online.target loganalyzer-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Dokumente/LotusIT/Projekte/logAnalyzer/frontend
ExecStart=/usr/bin/npm run dev -- --host 127.0.0.1 --port 5173
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
