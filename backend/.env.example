# Copy to .env and fill in values. Never commit .env to version control.

# Runtime environment: development | production
APP_ENV=development

# Application metadata
APP_VERSION=0.1.0
BUILD_COMMIT=local

# PostgreSQL connection (asyncpg DSN format)
DATABASE_URL=postgresql+asyncpg://loganalyzer:changeme@127.0.0.1:5432/loganalyzer

# Ollama base URL (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# HMAC secret for signing API tokens (min 32 chars)
API_TOKEN_SIGNING_KEY=CHANGEME_min_32_characters_here_xxxxx

# Comma-separated allowed CORS origins
# Production example: https://yourdomain.webgo.de
# Development: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public base URL of the backend (used in responses and docs)
PUBLIC_BASE_URL=http://localhost:8080

# Watcher polling (file & journald ingestion).
# Adaptive catch-up loop:
#   - WATCHER_INTERVAL_SECONDS: sleep between ticks when nothing was ingested
#     (idle polling). Lower = fresher data, higher DB load.
#   - WATCHER_CATCHUP_MIN_SLEEP_SECONDS: sleep between ticks while a backlog is
#     being drained (any lines were ingested in the previous tick).
WATCHER_INTERVAL_SECONDS=0.5
WATCHER_CATCHUP_MIN_SLEEP_SECONDS=0.02
